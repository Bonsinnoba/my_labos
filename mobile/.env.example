# MOBILE APP ENVIRONMENT CONFIGURATION
# Note: For Expo / React Native, all environment variables must be
# prefixed with EXPO_PUBLIC_ to be bundled into the app


# SUPABASE CONFIGURATION (REQUIRED)
# Supabase project URL and anon key for direct database access
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# INSTAPODS HUB CONFIGURATION (REQUIRED)
# Instapods Hub URL for file upload/download via signed URLs
EXPO_PUBLIC_INSTAPODS_URL=https://your-instapods-domain.com
# Instapods Hub URL for authentication (login/logout)
EXPO_PUBLIC_INSTAPODS_HUB_URL=https://your-instapods-domain.com


# CLOUD API CONFIGURATION (REQUIRED)
# Set this to your cloud-hosted API endpoint URL
EXPO_PUBLIC_CLOUD_API_URL=http://YOUR_CLOUD_API_URL:8000

# API timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT=30000


# SYNC CONFIGURATION
# Auto-sync interval in milliseconds (7500 = 7.5 seconds)
EXPO_PUBLIC_SYNC_INTERVAL=7500

# Unique device ID for this mobile device
EXPO_PUBLIC_DEVICE_ID=MOBILE_DEVICE_01

# BACKBLAZE B2 CONFIGURATION (REQUIRED)
# Account #1 - Light Storage Bucket (files < 50MB)
EXPO_PUBLIC_ACCOUNT_1_ENDPOINT=https://s3.us-east-005.backblazeb2.com
EXPO_PUBLIC_ACCOUNT_1_KEY_ID=your_account_1_key_id_here
EXPO_PUBLIC_ACCOUNT_1_APPLICATION_KEY=your_account_1_application_key_here
EXPO_PUBLIC_ACCOUNT_1_BUCKET=lab-light-storage

# Account #2 - Heavy Storage Bucket (files >= 50MB)
EXPO_PUBLIC_ACCOUNT_2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
EXPO_PUBLIC_ACCOUNT_2_KEY_ID=your_account_2_key_id_here
EXPO_PUBLIC_ACCOUNT_2_APPLICATION_KEY=your_account_2_application_key_here
EXPO_PUBLIC_ACCOUNT_2_BUCKET=lab-heavy-storage

# Mesh Sync Bucket (for transaction deltas)
EXPO_PUBLIC_MESH_SYNC_BUCKET=lab-mesh-sync
EXPO_PUBLIC_MESH_SYNC_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
EXPO_PUBLIC_MESH_SYNC_KEY_ID=your_mesh_sync_key_id_here
EXPO_PUBLIC_MESH_SYNC_APPLICATION_KEY=your_mesh_sync_application_key_here

# ENCRYPTION CONFIGURATION (OPTIONAL)
# Must be a 64-character hex string for AES-256-GCM
# Generate with: openssl rand -hex 32
EXPO_PUBLIC_ENCRYPTION_KEY=your_64_character_hex_key_here
EXPO_PUBLIC_ENABLE_ENCRYPTION=true

# GEMINI AI CONFIGURATION (OPTIONAL)
# Google API key for Gemini AI assistant features
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
