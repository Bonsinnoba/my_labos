# API Configuration
# Note: For Expo / React Native environment variables to be bundled, prefix them with EXPO_PUBLIC_
# For cloud access, set CLOUD_API_URL to your cloud-hosted API endpoint
# For local lab access, set API_BASE_URL to your lab computer IP
EXPO_PUBLIC_CLOUD_API_URL=http://YOUR_CLOUD_API_URL:8000
CLOUD_API_URL=http://YOUR_CLOUD_API_URL:8000
EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_IP:8000
API_BASE_URL=http://YOUR_PC_IP:8000
EXPO_PUBLIC_API_TIMEOUT=30000
API_TIMEOUT=30000

# Sync Configuration
EXPO_PUBLIC_SYNC_INTERVAL=7500
SYNC_INTERVAL=7500
EXPO_PUBLIC_DEVICE_ID=MOBILE_DEVICE_01
DEVICE_ID=MOBILE_DEVICE_01

# Backblaze B2 Configuration (Dual-Account for 20GB Free Tier Maximization)
# Account #1 - Light Storage Bucket (files < 50MB)
EXPO_PUBLIC_ACCOUNT_1_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
ACCOUNT_1_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
EXPO_PUBLIC_ACCOUNT_1_KEY_ID=your_account_1_key_id_here
ACCOUNT_1_KEY_ID=your_account_1_key_id_here
EXPO_PUBLIC_ACCOUNT_1_APPLICATION_KEY=your_account_1_application_key_here
ACCOUNT_1_APPLICATION_KEY=your_account_1_application_key_here
EXPO_PUBLIC_ACCOUNT_1_BUCKET=lab-light-storage
ACCOUNT_1_BUCKET=lab-light-storage

# Account #2 - Heavy Storage Bucket (files >= 50MB)
EXPO_PUBLIC_ACCOUNT_2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
ACCOUNT_2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
EXPO_PUBLIC_ACCOUNT_2_KEY_ID=your_account_2_key_id_here
ACCOUNT_2_KEY_ID=your_account_2_key_id_here
EXPO_PUBLIC_ACCOUNT_2_APPLICATION_KEY=your_account_2_application_key_here
ACCOUNT_2_APPLICATION_KEY=your_account_2_application_key_here
EXPO_PUBLIC_ACCOUNT_2_BUCKET=lab-heavy-storage
ACCOUNT_2_BUCKET=lab-heavy-storage

# Mesh Sync Configuration (for mobile cloud API access)
EXPO_PUBLIC_MESH_SYNC_BUCKET=lab-mesh-sync
MESH_SYNC_BUCKET=lab-mesh-sync

# Encryption Configuration
EXPO_PUBLIC_ENCRYPTION_KEY=your_64_character_hex_key_here
ENCRYPTION_KEY=your_64_character_hex_key_here
EXPO_PUBLIC_ENABLE_ENCRYPTION=true
ENABLE_ENCRYPTION=true
